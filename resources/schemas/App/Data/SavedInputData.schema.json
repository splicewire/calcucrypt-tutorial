{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Saved inputs",
    "properties": {
        "id": {
            "type": "string",
            "x-stud-widget-contexts": {
                "list-column": {
                    "participates": true
                }
            }
        },
        "calculator": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "inputs": {
            "type": "object",
            "additionalProperties": {
                "type": ["number", "string"]
            }
        },
        "savedAt": {
            "type": ["string", "null"]
        }
    },
    "required": ["id", "calculator", "name", "inputs", "savedAt"],
    "$id": "SavedInputData"
}
