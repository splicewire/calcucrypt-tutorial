{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "GuideShowPageData",
    "properties": {
        "guide": {
            "$ref": "#/$defs/GuideData"
        },
        "embeds": {
            "type": "array"
        },
        "links": {
            "type": "array"
        }
    },
    "required": [
        "guide",
        "embeds",
        "links"
    ],
    "$id": "GuideShowPageData",
    "$defs": {
        "GuideData": {
            "type": "object",
            "title": "Guide",
            "properties": {
                "slug": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "teaser": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bodyHtml": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "category": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "publishedAt": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "slug",
                "title",
                "teaser",
                "bodyHtml",
                "category",
                "publishedAt"
            ]
        }
    }
}