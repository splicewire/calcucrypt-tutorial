APP_NAME=Beam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Registration door (BUY-05): closed unless 'open'. Invitation claims are their own door.
ACCOUNT_REGISTRATION=closed
# The Vite build reads the same door, so the editor registers the register island only where the route is mounted.
VITE_ACCOUNT_REGISTRATION="${ACCOUNT_REGISTRATION}"

# Public intake door (laravel-beam's POST /beam/intake/{schema}): off unless true. The Vite build reads the same
# switch, so page forms are offered and registered exactly where the server accepts their submissions.
BEAM_INTAKE_ENABLED=false
VITE_BEAM_INTAKE_ENABLED="${BEAM_INTAKE_ENABLED}"

# MDX pages hold blocks (ADR-0233): off until this host's MDX pages are converted. The Vite build reads the same switch,
# so the editor registers the beam-mdx kit those pages place exactly where the server offers it. After turning it on,
# rebuild, run `php artisan splicewire:beam:ux:convert-mdx --dry-run` then the real run for this site's own pages (and
# publish the Release it opens), and run `php artisan splicewire:beam:seed --force` so each package converts its own
# unedited pages (the docs pages). Until then they keep MDX source while they declare blocks, and the editor cannot open
# them.
BEAM_UX_MDX_HOLDS_BLOCKS=false
VITE_BEAM_UX_MDX_HOLDS_BLOCKS="${BEAM_UX_MDX_HOLDS_BLOCKS}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The origin that SERVES this host's JSON Schemas, and therefore the authority of
# every versioned `$id` it mints (config/data-schemas.php). Deliberately left
# UNSET: a schema `$id` is write-once, so a starter default would bake a wrong
# authority into every artifact a clone freezes. Set it before you declare your
# first SchemaIdentity class — until you do, generating one fails loudly.
# Must be ABSOLUTE and path-shaped; a relative value like `/schemas` names no
# origin and is rejected (beam-facade ticket 112).
# SCHEMA_BASE_URI=https://app.example.com/schemas
