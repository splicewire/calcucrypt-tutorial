{
  "_comment": "Golden vectors shared by the PHP (tests/Unit/ExpressionEvaluatorTest.php) and TS (resources/js/calculators/expression/evaluate.test.ts) evaluator suites. Both must produce these exact results — this fixture is the oracle that fails CI if the two evaluators drift. Edit in one place, both sides re-run.",
  "cases": [
    { "expr": "1 + 2 * 3", "env": {}, "expect": 7 },
    { "expr": "(1 + 2) * 3", "env": {}, "expect": 9 },
    { "expr": "10 / 4", "env": {}, "expect": 2.5 },
    { "expr": "2 - 3 - 4", "env": {}, "expect": -5 },
    { "expr": "10 % 3", "env": {}, "expect": 1 },
    { "expr": "10.5 % 3", "env": {}, "expect": 1.5 },
    { "expr": "-5 + 3", "env": {}, "expect": -2 },
    { "expr": "-(2 + 3)", "env": {}, "expect": -5 },
    { "expr": "5 * -2", "env": {}, "expect": -10 },
    { "expr": "100 * 0.5", "env": {}, "expect": 50 },
    { "expr": "2 > 1", "env": {}, "expect": true },
    { "expr": "2 < 1", "env": {}, "expect": false },
    { "expr": "2 >= 2", "env": {}, "expect": true },
    { "expr": "2 <= 1", "env": {}, "expect": false },
    { "expr": "1 == 1", "env": {}, "expect": true },
    { "expr": "1 != 2", "env": {}, "expect": true },
    { "expr": "3 % 2 == 1", "env": {}, "expect": true },
    { "expr": "1 < 2 && 3 < 4", "env": {}, "expect": true },
    { "expr": "1 > 2 || 3 < 4", "env": {}, "expect": true },
    { "expr": "!(1 > 2)", "env": {}, "expect": true },
    { "expr": "(1 < 2) == (3 < 4)", "env": {}, "expect": true },
    { "expr": "1 > 2 ? 10 : 20", "env": {}, "expect": 20 },
    { "expr": "1 == 1 ? 2 == 3 ? 10 : 20 : 30", "env": {}, "expect": 20 },
    { "expr": "min(3, 7, 2)", "env": {}, "expect": 2 },
    { "expr": "max(3, 7, 2)", "env": {}, "expect": 7 },
    { "expr": "abs(-4.5)", "env": {}, "expect": 4.5 },
    { "expr": "sqrt(16)", "env": {}, "expect": 4 },
    { "expr": "pow(2, 10)", "env": {}, "expect": 1024 },
    { "expr": "round(2.5)", "env": {}, "expect": 3 },
    { "expr": "round(-2.5)", "env": {}, "expect": -3 },
    { "expr": "round(2.4)", "env": {}, "expect": 2 },
    { "expr": "round(3.14159, 2)", "env": {}, "expect": 3.14 },
    { "expr": "amount * buyPrice", "env": { "amount": 2, "buyPrice": 100 }, "expect": 200 },
    { "expr": "amount * sellPrice - amount * buyPrice", "env": { "amount": 2, "sellPrice": 150, "buyPrice": 100 }, "expect": 100 },
    { "expr": "cost == 0 ? 0 : (profit / cost) * 100", "env": { "cost": 0, "profit": 100 }, "expect": 0 },
    { "expr": "cost == 0 ? 0 : (profit / cost) * 100", "env": { "cost": 200, "profit": 100 }, "expect": 50 },
    { "expr": "cost != 0 && profit / cost > 0", "env": { "cost": 0, "profit": 100 }, "expect": false }
  ]
}
