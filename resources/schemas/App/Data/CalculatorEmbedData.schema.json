{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "CalculatorEmbedData",
    "properties": {
        "anchor": {
            "type": ["string", "null"]
        },
        "spec": {
            "$ref": "#/$defs/CalculatorSpecData"
        },
        "resolution": {
            "anyOf": [
                {
                    "$ref": "#/$defs/CalculatorResolutionData"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": ["anchor", "spec", "resolution"],
    "$id": "CalculatorEmbedData",
    "$defs": {
        "CalculatorSpecData": {
            "type": "object",
            "title": "Calculator",
            "properties": {
                "slug": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "summary": {
                    "type": ["string", "null"]
                },
                "key": {
                    "type": "string"
                },
                "category": {
                    "type": ["string", "null"]
                },
                "graph": {
                    "type": ["object", "null"]
                },
                "locked": {
                    "type": "boolean"
                },
                "requiredPlan": {
                    "type": ["string", "null"]
                }
            },
            "required": [
                "slug",
                "name",
                "summary",
                "key",
                "category",
                "graph",
                "locked",
                "requiredPlan"
            ]
        },
        "FactData": {
            "type": "object",
            "title": "FactData",
            "properties": {
                "value": {
                    "type": "number"
                },
                "source": {
                    "type": "string"
                },
                "asOf": {
                    "type": "string"
                },
                "connector": {
                    "type": "string"
                },
                "metric": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                },
                "stale": {
                    "type": "boolean",
                    "default": false
                },
                "changePercent24h": {
                    "type": ["number", "null"]
                }
            },
            "required": [
                "value",
                "source",
                "asOf",
                "connector",
                "metric",
                "symbol",
                "stale",
                "changePercent24h"
            ]
        },
        "CalculatorResolutionData": {
            "type": "object",
            "title": "Calculator resolution",
            "properties": {
                "facts": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/FactData"
                    }
                },
                "seedEnv": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number"
                    }
                },
                "seedVectors": {
                    "type": "array",
                    "default": []
                },
                "vectorFacts": {
                    "type": "array",
                    "default": []
                }
            },
            "required": ["facts", "seedEnv", "seedVectors", "vectorFacts"]
        }
    }
}
