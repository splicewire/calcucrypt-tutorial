        "types:check": "composer types:generate && pnpm frame:vocabulary && tsc --noEmit && tsc -p tsconfig.generated.json",
        "frame:vocabulary": "frame-vocabulary --readers @splicewire/beam-inertia/frame-readers",
        "beam:verify-prototype-boundary": "beam-verify-prototype-boundary",
        "test": "vitest run"
