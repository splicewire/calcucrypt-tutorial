{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Saved inputs",
    "properties": {
        "id": {
            "type": "string"
        },
        "calculator": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "inputs": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "savedAt": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "id",
        "calculator",
        "name",
        "inputs",
        "savedAt"
    ],
    "$id": "SavedInputData"
}