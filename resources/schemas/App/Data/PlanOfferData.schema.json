{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Plan",
    "properties": {
        "slug": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "summary": {
            "type": "string"
        },
        "price": {
            "type": "integer"
        },
        "currency": {
            "type": "string"
        },
        "unlocks": {
            "type": "array"
        }
    },
    "required": ["slug", "name", "summary", "price", "currency", "unlocks"],
    "$id": "PlanOfferData"
}
